{
    "type": "module",
    "engines": {
        "node": ">=26"
    },
    "scripts": {
        "dev": "node src/server.ts",
        "start": "node src/server.ts",
        "test": "vitest run",
        "dgt:replay": "node scripts/dgt-replay.ts",
        "dgt:probe": "node scripts/dgt-probe.ts",
        "format": "oxfmt --write src tests services scripts/*.ts .vscode oxlint.json tsconfig.json",
        "format:check": "oxfmt --check src tests services scripts/*.ts .vscode oxlint.json tsconfig.json",
        "lint": "tsc --noEmit && oxlint src tests services",
        "check": "node --run format:check && node --run lint && node --run test"
    },
    "dependencies": {
        "chess.js": "^1.4.0",
        "serialport": "^13.0.0",
        "ws": "^8.22.0"
    },
    "devDependencies": {
        "@types/node": "^26.6.5",
        "@types/ws": "^8.18.2",
        "oxfmt": "^0.75.0",
        "oxlint": "^1.90.0",
        "typescript": "^7.0.2",
        "vitest": "^5.0.5"
    }
}
